{"version":3,"kind":"Notebook","sha256":"7b2fe89d45dc3a979d0aa69288027bee1f17442ca6d5b4b95fcd9aa105cef070","slug":"geometri-plotting","location":"/matematikk/Geometri-plotting.ipynb","dependencies":[],"frontmatter":{"title":"Geometri med pyplot","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"numbering":{"title":{"offset":1}},"thumbnail":"/geom_pyplot_1-cd91c6341c3f2d7acef2f9325daa6ebe.png","exports":[{"format":"ipynb","filename":"Geometri-plotting.ipynb","url":"/Geometri-plotting-631f799aa4b4aea04cd55e8e2944fa22.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Mange har antakeligvis brukt turtle til å programmere forskjellige figurer. Turtle fungerer bra til dette. Man kan også bruke matplotlib.pyplot, som er et eget biblitek med funksjoner spesielt for visualiseringa av data. F.eks. grafer, diagrammer, figurer og mye mer. Både 2D og 3D.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZiYo6Tkckd"}],"key":"Bc800Rv856"}],"key":"dXYYKwMZEs"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Litt utforsking med pyplot","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"V3M9NFfDb0"}],"identifier":"litt-utforsking-med-pyplot","label":"Litt utforsking med pyplot","html_id":"litt-utforsking-med-pyplot","implicit":true,"key":"wX8aH9zsXs"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Les over koden under. Legg merke det er lagt til ekstra linjeskift for å skape luft i koden. Du kan forandre på det meste men x og y er to lister som tilsammen er som en vanlig funksjonstabell for plotting av punkter til en graf. Det kommer oppgaver etter koden.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Xn9WvU2cWJ"}],"key":"gnymlrBygY"}],"key":"vdzCjqpAjw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\n\n\n\n\n# Punkter i firkanten\nx = [0, 4, 4, 0, 0]\ny = [0, 0, 3, 3, 0]               # greit å forstå mulighetene her\n\n\n\nplt.plot(x, y)                   # plotter\nplt.gca().set_aspect('equal')    # riktig geometrisk forhold\n# plt.text(A[0], A[1]-0.2, f\"{vA:.1f}°\")\nplt.axis(\"on\")                   # sett til off hvis du vil fjerne akser og benevning.\nplt.title(\"Firkant\")\nplt.show()","key":"FVaCBgTCFT"},{"type":"outputs","id":"eCxIw9JxQxKLYuo2g3-4o","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"751dea5221510c43da17dba7e01532d9","path":"/751dea5221510c43da17dba7e01532d9.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"wL17EZvk57"}],"key":"HAXn95pIto"}],"key":"UWMQzASVb3"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Oppgaver","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FtNpPcKzO2"}],"key":"dd6S1bZwg7"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Tenk over hvorfor “tabellen” starter med (0,0) og ender med (0,0)?","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"NuzPdBK8YM"}],"key":"mlbbmQghRs"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Hvordan kan du forandre på koden for å lag