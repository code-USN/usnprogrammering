n\n# Punkter i firkanten\nx = [0, 4, 4, 0, 0]\ny = [0, 0, 3, 3, 0]  #greit å forstå mulighetene her\n\nplt.plot(x, y)\nplt.gca().set_aspect('equal')  # riktig geometrisk forhold\n# plt.text(A[0], A[1]-0.2, f\"{vA:.1f}°\")\nplt.axis(\"on\") # sett til off hvis du vil fjerne akser og benevning.\nplt.title(\"Firkant\")\nplt.show()","key":"bRCkgeYX6X"},{"type":"outputs","id":"sYhH-nCgLDvV0nRBITZ07","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"751dea5221510c43da17dba7e01532d9","path":"/751dea5221510c43da17dba7e01532d9.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"VhrNha4m1U"}],"key":"JnAP23sOKY"}],"key":"iY5JuH7mom"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Hvordan utforske mangekanter med python og matplotlib?","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"C6vVYwc8AD"}],"key":"dM0jeD0PS8"}],"key":"TGcehwXyOT"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\nimport math\n\n# Antall sider\nn = 7   # prøv 3, 4, 5, 8, 12 …\n\n# Radius og sentrum\nradius = 3\ncx = 0\ncy = 0\n\nx = []\ny = []\n\n# Regn ut punktene\nfor i in range(n):\n    vinkel = 2 * math.pi * i / n + math.pi/2\n    x.append(cx + radius * math.cos(vinkel) )\n    y.append(cy + radius * math.sin(vinkel) )\n    print((vinkel/math.pi * 360)/2)\n\n#print(round(x,2))\n#print(round(y,2))\n\n# Lukk figuren\nx.append(x[0])\ny.append(y[0])\n\n# Tegn mangekanten\nplt.fill(x, y, color=\"skyblue\", edgecolor=\"blue\", alpha=0.5)\nplt.plot(x, y)\n# plt.scatter(x[:-1], y[:-1])\n\nplt.gca().set_aspect(\"equal\")\nplt.axis(\"off\")\nplt.title(\"Regulær mangekant med \" + str(n) + \" sider\")\nplt.show()\n","key":"uasOVvAjzX"},{"type":"outputs","id":"I-u3myDhgTJo4yJ8LqH-U","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"90.0\n141.42857142857142\n192.85714285714286\n244.2857142857143\n295.7142857142857\n347.14285714285717\n398.5714285714286\n"},"children":[],"key":"KPMcQSxXE6"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"e584e2ceff21bd839da6edebd02673bf","path":"/e584e2ceff21bd839da6edebd02673bf.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"tlzmtge87d"}],"key":"QxdfudLRB1"}],"key":"GjCWEGsFIb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"lU5xdFYfke"},{"type":"outputs","id":"YPa0UqSkX0kC60g0mzVzc","children":[],"key":"Ixb0j9NK32"}],"key":"m2vcjt7NAu"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"LItBd9O6eL"},{"type":"outputs","id":"fwJAeSBNbYYgnpPTZi1pV","children":[],"key":"mNX9mjdLx3"}],"key":"gmRI4CaZy8"}],"key":"yz7u2t1zaw"},"references":{"cite":{"order":[],"data":{}}}}