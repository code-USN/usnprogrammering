n slik enkel “tabell” som består av to lister, x og y, så kan man visualisere data i f.eks. andre typer grafer eller f.eks diagrammer som stolpe eller søyle diagram. I dette opplegget skal vi ikke gå den veien","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XFrWLsZja6"}],"key":"ImZYE3D6yX"}],"key":"xhueySrbiH"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Hvordan utforske mangekanter med python og matplotlib?","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kkC81DigUB"}],"identifier":"hvordan-utforske-mangekanter-med-python-og-matplotlib","label":"Hvordan utforske mangekanter med python og matplotlib?","html_id":"hvordan-utforske-mangekanter-med-python-og-matplotlib","implicit":true,"key":"gZjsAFGMQV"}],"key":"i68xeCYVIn"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"For kunne bruke matplotlib.pyplot som et verktøy for visualisering så er det viktig at vi tar en kikk på matematikken. I det følgende segmentet skal vi se på hvordan vi kan regne ut x- og y-koordinatene til etthvert punkt på listen.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jRBAKZg1oy"}],"key":"yKb2w8TOD3"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Vi skal se på noen figurer fra Geogebra som forklarer hvordan sammenhengen er med vinkler og x,y-koordinatene.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JcSR3JGJPn"}],"key":"f3qyZ7QO4i"}],"key":"tTy63oJbrS"},{"type":"block","kind":"notebook-content","children":[{"type":"image","url":"/geom_pyplot_1-cd91c6341c3f2d7acef2f9325daa6ebe.png","alt":"Alternativ tekst","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fvNRHketxQ","urlSource":"images/geom_pyplot_1.png"}],"key":"ajcsbs9RXi"},{"type":"block","kind":"notebook-content","children":[{"type":"image","url":"/geom_pyplot_2-c7cfd37bc62df89245d8a4c826dbe21c.png","alt":"Alternativ tekst","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"AMVfXVFHvP","urlSource":"images/geom_pyplot_2.png"}],"key":"crZ6NaEyjG"},{"type":"block","kind":"notebook-content","children":[{"type":"image","url":"/geom_pyplot_3-6469691945945bbdf211a957d0520df8.png","alt":"Alternativ tekst","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wAbpp0Vmkz","urlSource":"images/geom_pyplot_3.png"}],"key":"BjJ7ZBH3sY"},{"type":"block","kind":"notebook-content","children":[{"type":"image","url":"/geom_pyplot_1-cd91c6341c3f2d7acef2f9325daa6ebe.png","width":200,"key":"bHeJIT22fG","urlSource":"images/geom_pyplot_1.png"}],"key":"ghBfqsCzQk"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Figuren over til venstre viser at vi tenker at en sektor i sirkelen som består av punktene A, C og D. Figuren over til høyre viser denne sektoren bedre med vinkel ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xTZTOxyDTQ"},{"type":"inlineMath","value":"\\alpha","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>α</mi></mrow><annotation encoding=\"application/x-tex\">\\alpha</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0037em;\">α</span></span></span></span>","key":"wakBRvh8ww"},{"type":"text","value":" som denne gangen er på ca. 27 ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gdXMmcobfx"},{"type":"text","value":"°","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"C1LRL7HkrN"},{"type":"text","value":". Vi ser på figurene over at koordinatene til punktet D,er det neste punktet programmet under skal “tegne” opp og deretter fortsette med neste","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"a1r5ahLBb2"}],"key":"FeKqpV2o2K"}],"key":"f3Ip7lVpIN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\nimport math\n\n# Antall sider\nn = 7   # prøv 3, 4, 5, 8, 12 …\n\n# Radius og sentrum\n# Velger radius = 3 for å ha størrelse på figuren. \n# Dersom du velger 0 så har figuren ikke omfang. \nradius = 3              \ncx = 0\ncy = 0\n\nx = []\ny = []\n\n# Regn ut punktene\nfor i in range(n):\n    vinkel = (2 * math.pi * i / n) + (math.pi/2)\n    x.append(cx + radius * math.cos(vinkel) )\n    y.append(cy + radius * math.sin(vinkel) )\n    print((vinkel/math.pi * 360)/2)\n    #print(vinkel)\n\n#print(round(x,2))\n#print(round(y,2))\n\n# Lukk figuren\nx.append(x[0])\ny.append(y[0])\n\n# Tegn mangekanten\nplt.fill(x, y, color=\"skyblue\", edgecolor=\"blue\", alpha=0.5)\nplt.plot(x, y)\n# plt.scatter(x[:-1], y[:-1])\n\nplt.gca().set_aspect(\"equal\")\nplt.axis(\"off\")\nplt.title(\"Regulær mangekant med \" + str(n) + \" sider\")\nplt.show()\n","key":"vTkPtF2Grk"},{"type":"outputs","id":"SHBDS_2nJhVJoD7In1fS3","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"90.0\n141.42857142857142\n192.85714285714286\n244.2857142857143\n295.7142857142857\n347.14285714285717\n398.5714285714286\n"},"children":[],"key":"bzNE0XxziZ"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png",