{"version":3,"kind":"Notebook","sha256":"b00806d3285914db25032d3b7d03618e7c0fc358c914c341d8d3ee0f0fae4103","slug":"geometri-plotting","location":"/matematikk/Geometri-plotting.ipynb","dependencies":[],"frontmatter":{"title":"Geometri med pyplot","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"numbering":{"title":{"offset":1}},"exports":[{"format":"ipynb","filename":"Geometri-plotting.ipynb","url":"/Geometri-plotting-5ecef16bf07fa4c370b4e002328f54db.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Mange har antakeligvis brukt turtle til å programmere forskjellige figurer. Turtle fungerer bra til dette. Man kan også bruke matplotlib.pyplot, som er et eget biblitek med funksjoner spesielt for visualiseringa av data. F.eks. grafer, diagrammer, figurer og mye mer. Både 2D og 3D.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rnhTu50GAq"}],"key":"sEcGylKYmA"}],"key":"zhhMNvLK0q"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Litt utforsking med pyplot","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TCiP1pb5bV"}],"identifier":"litt-utforsking-med-pyplot","label":"Litt utforsking med pyplot","html_id":"litt-utforsking-med-pyplot","implicit":true,"key":"d6JwwpY4G0"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Les over koden under. Legg merke det er lagt til ekstra linjeskift for å skape luft i koden. Du kan forandre på det meste men x og y er to lister som tilsammen er som en vanlig funksjonstabell for plotting av punkter til en graf. Det kommer oppgaver etter koden.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"gU3RIETsPK"}],"key":"FblauBYeFI"}],"key":"Ckj45NB6Ze"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\n\n\n\n\n# Punkter i firkanten\nx = [0, 4, 4, 0, 0]\ny = [0, 0, 3, 3, 0]               # greit å forstå mulighetene her\n\n\n\nplt.plot(x, y)                   # plotter\nplt.gca().set_aspect('equal')    # riktig geometrisk forhold\n# plt.text(A[0], A[1]-0.2, f\"{vA:.1f}°\")\nplt.axis(\"on\")                   # sett til off hvis du vil fjerne akser og benevning.\nplt.title(\"Firkant\")\nplt.show()","key":"ZNSCCvnUCZ"},{"type":"outputs","id":"RCMf26AuI9AXrEQBF3uJo","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"751dea5221510c43da17dba7e01532d9","path":"/751dea5221510c43da17dba7e01532d9.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"NKFsLQSsff"}],"key":"wzXZGEK24V"}],"key":"V0jO3kpVd2"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Oppgaver","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"J0JrTFnYws"}],"key":"HrJkANJ4eH"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Tenk over hvorfor “tabellen” starter med (0,0) og ender med (0,0)?","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"zsZg4j1YU0"}],"key":"WcjoLEcGrk"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Hvordan kan du forandre på koden for å lage en annen figur?","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"exJshQufmY"}],"key":"dq9ze85puF"}],"key":"t4QbLIajPz"}],"key":"AKCoxQG2lt"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"hint","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Løsningsforslag","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nNoGRSrb3A"}],"key":"hCmFdcIpWH"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Tabellen slutter på punktet (0,0) for å “lukke” figuren. Figuren begynner på (0,0), men kan selvsagt begynne på andre punkter.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jEIJFukGMB"}],"key":"QbYdOm1fXt"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Et par tips kan være å lage “tabellen” lengre.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Bww9wI3Nel"}],"key":"YpmadFVeAh"},{"type":"code","lang":"python","value":"x = [1, 2, 2.5, 2, 1, 0.5, 1]\ny = [0, 0, 0.87, 1.74, 1.74, 0.87, 0]","key":"CppDZtGnjY"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Disse punktene er funnet ved hjelp av litt matematikk på bakrommet. Men poenget er at man kan bruke denne måten i pyplot også til å lage geometriske figurer. Tabellene ser ut til å være av ulik lengde, men det er kun på forskjeller i antall desimaler.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"Iarn6aQELx"}],"key":"jozZBXh3xj"}],"class":"dropdown","key":"OpFwgsMSvL"}],"key":"K4sO6iXZtW"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Ved bruk av en slik enkel “tabell” som består av to lister, x og y, så kan man visualisere data i f.eks. andre typer grafer eller f.eks diagrammer som stolpe eller søyle diagram. I dette opplegget skal vi ikke gå den veien","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xyZhwtdUOz"}],"key":"anwoDseLxU"}],"key":"pySUUzg4e9"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Hvordan utforske mangekanter med python og matplotlib?","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zK9JMCwesC"}],"identifier":"hvordan-utforske-mangekanter-med-python-og-matplotlib","label":"Hvordan utforske mangekanter med python og matplotlib?","html_id":"hvordan-utforske-mangekanter-med-python-og-matplotlib","implicit":true,"key":"v5MZDMD4nh"}],"key":"X7vkNeYSKj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\nimport math\n\n# Antall sider\nn = 7   # prøv 3, 4, 5, 8, 12 …\n\n# Radius og sentrum\nradius = 3\ncx = 0\ncy = 0\n\nx = []\ny = []\n\n# Regn ut punktene\nfor i in range(n):\n    vinkel = 2 * math.pi * i / n + math.pi/2\n    x.append(cx + radius * math.cos(vinkel) )\n    y.append(cy + radius * math.sin(vinkel) )\n    print((vinkel/math.pi * 360)/2)\n\n#print(round(x,2))\n#print(round(y,2))\n\n# Lukk figuren\nx.append(x[0])\ny.append(y[0])\n\n# Tegn mangekanten\nplt.fill(x, y, color=\"skyblue\", edgecolor=\"blue\", alpha=0.5)\nplt.plot(x, y)\n# plt.scatter(x[:-1], y[:-1])\n\nplt.gca().set_aspect(\"equal\")\nplt.axis(\"off\")\nplt.title(\"Regulær mangekant med \" + str(n) + \" sider\")\nplt.show()\n","key":"GofHjuZhyV"},{"type":"outputs","id":"uSiKO5o6dcQJTxMAWH2AW","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"90.0\n141.42857142857142\n192.85714285714286\n244.2857142857143\n295.7142857142857\n347.14285714285717\n398.5714285714286\n"},"children":[],"key":"KlKPJa18IB"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"e584e2ceff21bd839da6edebd02673bf","path":"/e584e2ceff21bd839da6edebd02673bf.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"NK6Ws8UjPK"}],"key":"mGKS9g3fTt"}],"key":"KTrqv5lWao"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"KKLdyOfvg0"},{"type":"outputs","id":"gNv8lGeKIqWnzRRuR1iUd","children":[],"key":"qFuv8HeRyO"}],"key":"gS82SDAdQF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"yi1jIP5W8y"},{"type":"outputs","id":"yvxOHeN1Eo1sEM5Uu8UVd","children":[],"key":"eg2bGT2Y16"}],"key":"sTC961BDFr"}],"key":"nghvsXYsr0"},"references":{"cite":{"order":[],"data":{}}}}