Hw-cGi_OKE","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"751dea5221510c43da17dba7e01532d9","path":"/751dea5221510c43da17dba7e01532d9.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"abSdUMSG1G"}],"key":"uMqKx7CwIU"}],"key":"PArvN4pqij"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Hvordan utforske mangekanter med python og matplotlib?","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JBWlFsbpKq"}],"key":"Eo9P5aExMh"}],"key":"f2l3iV7c0y"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\nimport math\n\n# Antall sider\nn = 7   # prøv 3, 4, 5, 8, 12 …\n\n# Radius og sentrum\nradius = 3\ncx = 0\ncy = 0\n\nx = []\ny = []\n\n# Regn ut punktene\nfor i in range(n):\n    vinkel = 2 * math.pi * i / n + math.pi/2\n    x.append(cx + radius * math.cos(vinkel) )\n    y.append(cy + radius * math.sin(vinkel) )\n    print((vinkel/math.pi * 360)/2)\n\n#print(round(x,2))\n#print(round(y,2))\n\n# Lukk figuren\nx.append(x[0])\ny.append(y[0])\n\n# Tegn mangekanten\nplt.fill(x, y, color=\"skyblue\", edgecolor=\"blue\", alpha=0.5)\nplt.plot(x, y)\n# plt.scatter(x[:-1], y[:-1])\n\nplt.gca().set_aspect(\"equal\")\nplt.axis(\"off\")\nplt.title(\"Regulær mangekant med \" + str(n) + \" sider\")\nplt.show()\n","key":"L0gBdGZKZw"},{"type":"outputs","id":"LB2GoNmfDqJMkm7dybMDv","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"90.0\n141.42857142857142\n192.85714285714286\n244.2857142857143\n295.7142857142857\n347.14285714285717\n398.5714285714286\n"},"children":[],"key":"l8yJ1hjmCn"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"e584e2ceff21bd839da6edebd02673bf","path":"/e584e2ceff21bd839da6edebd02673bf.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"KWpaLFy98t"}],"key":"tUoD2A1ToU"}],"key":"IhA08jyIWL"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"ygrlAIP6MO"},{"type":"outputs","id":"3ulWb6lWlUhSNeWkuC2Fy","children":[],"key":"eddC4mDdFt"}],"key":"VIYt8Ozctj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"bO8qixfKXg"},{"type":"outputs","id":"0xIAZnn7ICbmcav-5l_Rz","children":[],"key":"q4sXvlCgSB"}],"key":"ull1nuKnBG"}],"key":"HGf3ZaA5XA"},"references":{"cite":{"order":[],"data":{}}}}