8wY5rv8Dif","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"751dea5221510c43da17dba7e01532d9","path":"/751dea5221510c43da17dba7e01532d9.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"RECWHb4ffL"}],"key":"L3oo4YNEVC"}],"key":"EYVXDHSftc"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Hvordan utforske mangekanter med python og matplotlib?","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZSMstaIjz1"}],"key":"v9Acl2CwtY"}],"key":"AirnAg4s9r"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\nimport math\n\n# Antall sider\nn = 7   # prøv 3, 4, 5, 8, 12 …\n\n# Radius og sentrum\nradius = 3\ncx = 0\ncy = 0\n\nx = []\ny = []\n\n# Regn ut punktene\nfor i in range(n):\n    vinkel = 2 * math.pi * i / n + math.pi/2\n    x.append(cx + radius * math.cos(vinkel) )\n    y.append(cy + radius * math.sin(vinkel) )\n    print((vinkel/math.pi * 360)/2)\n\n#print(round(x,2))\n#print(round(y,2))\n\n# Lukk figuren\nx.append(x[0])\ny.append(y[0])\n\n# Tegn mangekanten\nplt.fill(x, y, color=\"skyblue\", edgecolor=\"blue\", alpha=0.5)\nplt.plot(x, y)\n# plt.scatter(x[:-1], y[:-1])\n\nplt.gca().set_aspect(\"equal\")\nplt.axis(\"off\")\nplt.title(\"Regulær mangekant med \" + str(n) + \" sider\")\nplt.show()\n","key":"Gpmt7DcaM1"},{"type":"outputs","id":"j5dcjGb84ScZrB72Jj-fC","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"90.0\n141.42857142857142\n192.85714285714286\n244.2857142857143\n295.7142857142857\n347.14285714285717\n398.5714285714286\n"},"children":[],"key":"F5qyTFWp8D"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"e584e2ceff21bd839da6edebd02673bf","path":"/e584e2ceff21bd839da6edebd02673bf.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"id7dkGxvTI"}],"key":"hC89OnEN8z"}],"key":"x9aJDaFTUi"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"N9ENlrb0yo"},{"type":"outputs","id":"YDophB7HWuHK-ZkAzRO2a","children":[],"key":"YDuKgxYt4a"}],"key":"hX9pyehnUf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"Mgg5S4SLDk"},{"type":"outputs","id":"CLTyGnukVv2FAsrAxUKg3","children":[],"key":"cv2fLfPByq"}],"key":"rYbedLnUjb"}],"key":"Ns6qAl0YpX"},"references":{"cite":{"order":[],"data":{}}}}