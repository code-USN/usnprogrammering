 forskjellig. For nullpunkter undersøkte vi fortegnsskift, for ekstremalverdier må vi undersøke for topp- eller bunnpunkter. Et eksempel for kode kan være:","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"wYnKTdWwiN"}],"key":"g3QhTAP2Lx"}],"key":"KInc8ozzkP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Importerer biblioteker\nimport numpy as np\nimport matplotlib.pyplot as plt\n# Definerer funksjoner\ndef f(x):\n    return 4 - x**2\n\n# Antall elementer i x og y-tabellene\nN = 109\n# Lager x-tabell\nx = np.linspace(-3,3,N)\n# Lager y-tabell med tilhørende funksjonsverdier\ny = f(x)\n# Plotter grafen (ser om det faktisk finnes nullpkt)\nplt.plot(x,y, color=\"red\")\nplt.axvline(x=0, color=\"black\")\nplt.axhline(y=0, color=\"black\")\nplt.show()\n# Itererer y-tabellen for å finne topp eller bunnpunkter\nfor i in range(N-2):\n    # sjekker for toppunkt\n    if y[i] < y[i+1] and y[i+1] > y[i+2] :\n        print(\"toppunkt x = \" + str(x[i+1]) + \", y = \" + str(y[i+1]))\n    elif y[i] > y[i+1] and y[i+1] < y[i+2]:\n        print(\"bunnpunkt x = \" + str(x[i+1]) + \", y = \" + str(y[i+1]))","key":"xpKTrD7g4W"},{"type":"outputs","id":"-eEE4POWpGhImi0qzulw-","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"73b5ce95674b62c5ddb092f4e6da9d1a","path":"/73b5ce95674b62c5ddb092f4e6da9d1a.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"rLG8csnAjz"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"toppunkt x = 0.0, y = 4.0\n"},"children":[],"key":"g2q7ko37mb"}],"key":"CQyfCVsq9P"}],"key":"AW7bU4XNH6"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Oppgaver","position":{"start":{"l