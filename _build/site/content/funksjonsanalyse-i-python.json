punkt x = \" + str(x_snitt) + \", y = \" + str(f(x_snitt)))\n    # sjekker for bunnpunkt\n    elif y[i] > y[i+1] and y[i+1] < y[i+2]:\n        print(\"bunnpunkt x = \" + str(x[i+1]) + \", y = \" + str(y[i+1]))\n    elif y[i] == y[i+1] and y[i+1] < y[i+2]:\n        x_snitt = (x[i]+x[i+1])/2\n        print(\"bunnpunkt x = \" + str(x_snitt) + \", y = \" + str(f(x_snitt)))","key":"jWs7UTVFDg"}],"class":"dropdown","key":"Rl6SS0qJ81"}],"key":"eQTvBmhkTi"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Numerisk derivasjon (momentan vekstfart)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ghC6fqTaR6"}],"identifier":"numerisk-derivasjon-momentan-vekstfart","label":"Numerisk derivasjon (momentan vekstfart)","html_id":"numerisk-derivasjon-momentan-vekstfart","implicit":true,"key":"q3jNydqlM4"}],"key":"dkqxLuMUUl"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Med utgangspunkt i definisjonen for den deriverte, her er en Python-funksjon som finner den deriverte i ett valgt punkt på andregradsfunksjonen","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BOzvYRTuae"}],"key":"JDhajNNaTu"}],"key":"mpAbOjkZ9q"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Å finne vekstfarten i ett punkt","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WVilVyH0Is"}],"identifier":"id-finne-vekstfarten-i-ett-punkt","label":"Å finne vekstfarten i ett punkt","html_id":"id-finne-vekstfarten-i-ett-punkt","implicit":true,"key":"Da6aCvFkTx"}],"key":"HKt7DYj4Kx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def f(x):\n    return 4 - x**2\n\ndef deriverte(x,delta_x):\n    return (f(x+delta_x)-f(x))/delta_x\n\nx = 0\ndx = 0.01\n\nprint(\"Den deriverte i punkt (\" + str(x) + \", \" + str(f(x)) + \")\")\nprint(\"er: \" + str(deriverte(x, dx)))","key":"dSrM2WwHeV"},{"type":"outputs","id":"curpBS5-MxBnPSnoYgEKl","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Den deriverte i punkt (0, 4)\ner: -0.010000000000021103\n"},"children":[],"key":"AabWby6X4i"}],"key":"ftCjgEMjc7"}],"key":"deu9L4MBw2"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Tip","key":"w6EWgr88I7"}],"key":"VZ9o3YIZyQ"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Funksjonen ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"wmZkGPLkt0"},{"type":"inlineMath","value":"f(x)=4-x^2","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>f</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">)</mo><mo>=</mo><mn>4</mn><mo>−</mo><msup><mi>x</mi><mn>2</mn></msup></mrow><annotation encoding=\"application/x-tex\">f(x)=4-x^2</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.10764em;\">f</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\">x</span><span class=\"mclose\">)</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">4</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.8141em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">x</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">2</span></span></span></span></span></span></span></span></span></span></span>","key":"dZvGO8Qe7X"},{"type":"text","value":" er symmetrisk om y-aksen (som dere så ovenfor) og har toppunkt i (0,4), dvs at den deriverte i punktet (0,4) skal bli null. Hva sier Python? Hvorfor?\nPrøv å gjøre dx enda mindre, for eksempel 0,01, 0,001 osv. Hva skjer?\nPrøv med andre verdier for x, eller også å skrive inn andre funksjoner, og sammenlign med for eksempel Geogebra, eller regn fasit for hånd.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"kqzifOE7z8"}],"key":"eKtPpreaIk"}],"key":"AZXVe9H4yy"}],"key":"mh2DTzC4yH"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Numeriske begrensinger","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UpUgOjjeXo"}],"identifier":"numeriske-begrensinger","label":"Numeriske begrensinger","html_id":"numeriske-begrensinger","implicit":true,"key":"lPhXMY9cZ9"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"I matematikk bruker vi grenseverdien, når delta_x går mot 0, for å finne den deriverte analytisk. Det skulle da også være rimelig at det samme gjaldt når man regnet den deriverte numerisk med en datamaskin. Dette programmet analyserer hva forskjellen mellom den beregnede deriverte og den numeriske tilnærmingen blir for punktet (1, f(1)). Hva gjør programmet?","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"xvgKx0sF9S"}],"key":"ru0R1dpRaI"}],"key":"eLSMe0KGVD"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"python","value":"def f(x):\n    return x**2 - 2\n\n# analytisk derivert\ndef analytisk_derivert(x):\n    return 2*x\n\ndef numerisk_derivert(f, x, delta_x):\n    fder = (f(x + delta_x)-f(x))/delta_x\n    return fder\n\ndelta_x = []\n\nfor i in range(1,16):\n    dx = 10**(-i)\n    delta_x.append(dx)\n    numder = numerisk_derivert(f, 1, dx)\n    ander = analytisk_derivert(1)\n    feil = ander - numder\n    print(\"Delta_x =\", dx, \" avvik:\", feil)","key":"BaQBJ215It"}],"key":"ZSPNkIiAUP"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Tip","key":"TyrW13Cdo7"}],"key":"ek7WAmfZTk"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Kjør koden. Hva skjer med den numeriske tilnærmingen når den delta_x blir veldig liten? Hva er sweetspot for dx?","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"SDgoOuCXx2"}],"key":"ZVLKJagDuq"}],"key":"LBMg7mY16k"}],"key":"RZhjwq0OTq"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plotting av den deriverte","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CSRqv6va6l"}],"identifier":"plotting-av-den-deriverte","label":"Plotting av den deriverte","html_id":"plotting-av-den-deriverte","implicit":true,"key":"QRf4ThDuhJ"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Dersom man har en verditabell for x-verdier, kan man finne en verditabell for den deriverte også – dette er nødvendig dersom man vil plotte den deriverte: Kjør følgende kode, og prøv å se hva den gjør","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"WWHak09ODB"}],"key":"ga3nDlwCxT"}],"key":"HVfwXpMzbq"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"python","value":"import numpy as np\nimport matplotlib.pyplot as plt\n\ndef f(x):\n    return 4 - x**2\n\ndef fderivert(x, delta_x):\n    fder = (f(x + delta_x)-f(x))/delta_x\n    return fder\n\ndx = 0.00000001\n\nx = np.linspace(-3,3,100)\ny = f(x)\nderivert = fderivert(x, dx)\n\n\nplt.plot(x, y, color=\"red\")\nplt.plot(x, derivert, color = \"blue\")\n\nplt.axvline(x=0, color=\"black\")\nplt.axhline(y=0, color=\"black\")\nplt.show()","key":"e9KGwyW061"}],"key":"trYlb5LyDx"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Tip","key":"HcZ8Wlpeji"}],"key":"rVAlQX2NG1"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Eksperimenter med andre funksjoner, feks","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Gw4T84VfSA"}],"key":"HZmW76KXte"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"inlineMath","value":"f(x)=x^2-x+12","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>f</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">