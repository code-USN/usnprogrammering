print(\"x1 = \", str(x))\n    x = (-b + math.sqrt(b**2 - 4*a*c)) / (2*a)\n    print(\"x2 = \", str(x))\nelif b**2 == 4*a*c:\n    print(\"Funksjonen har ett nullpunkt\")\n    x = (-b + math.sqrt(b**2 - 4*a*c)) / (2*a)\n    print(\"x = \" + str(x))\nelse:\n    print(\"Funksjonen har ingen nullpunkter\")","key":"yDhkSm2dz2"}],"class":"dropdown","key":"F8YX18UDlm"}],"key":"xzyoXpVkQ6"}],"key":"q8guuni8mI"},"references":{"cite":{"order":[],"data":{}}}}