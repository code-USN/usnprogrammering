print(\"x1 = \", str(x))\n    x = (-b + math.sqrt(b**2 - 4*a*c)) / (2*a)\n    print(\"x2 = \", str(x))\nelif b**2 == 4*a*c:\n    print(\"Funksjonen har ett nullpunkt\")\n    x = (-b + math.sqrt(b**2 - 4*a*c)) / (2*a)\n    print(\"x = \" + str(x))\nelse:\n    print(\"Funksjonen har ingen nullpunkter\")","key":"k2dS05Xb2K"}],"class":"dropdown","key":"LhKcEbScvV"}],"key":"MUbY75EZgn"}],"key":"scGDi59fVL"},"references":{"cite":{"order":[],"data":{}}}}