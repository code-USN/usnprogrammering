b - math.sqrt(b**2 - 4*a*c)) / (2*a)\n    print(\"x1 = \", str(x))\n    x = (-b + math.sqrt(b**2 - 4*a*c)) / (2*a)\n    print(\"x2 = \", str(x))\nelif b**2 == 4*a*c:\n    print(\"Funksjonen har ett nullpunkt\")\n    x = (-b + math.sqrt(b**2 - 4*a*c)) / (2*a)\n    print(\"x = \" + str(x))\nelse:\n    print(\"Funksjonen har ingen nullpunkter\")","key":"vYFb3NX0lt"}],"class":"dropdown","key":"BYL9a08LPT"}],"key":"br18DEoJxi"}],"key":"wRf1G4Eqq0"},"references":{"cite":{"order":[],"data":{}}}}