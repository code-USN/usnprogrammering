print(\"x1 = \", str(x))\n    x = (-b + math.sqrt(b**2 - 4*a*c)) / (2*a)\n    print(\"x2 = \", str(x))\nelif b**2 == 4*a*c:\n    print(\"Funksjonen har ett nullpunkt\")\n    x = (-b + math.sqrt(b**2 - 4*a*c)) / (2*a)\n    print(\"x = \" + str(x))\nelse:\n    print(\"Funksjonen har ingen nullpunkter\")","key":"bX8Cxhko0D"}],"class":"dropdown","key":"ntU6rkNi7m"}],"key":"JqNYoepY7x"}],"key":"VUDQJgVQlm"},"references":{"cite":{"order":[],"data":{}}}}