2 == 4*a*c:\n    print(\"Funksjonen har ett nullpunkt\")\n    x = (-b + math.sqrt(b**2 - 4*a*c)) / (2*a)\n    print(\"x = \" + str(x))\nelse:\n    print(\"Funksjonen har ingen nullpunkter\")","key":"mPk3KS3WV4"}],"class":"dropdown","key":"rltBUq1DX9"}],"key":"kGnGUrrFsx"}],"key":"qCP7OE3kxr"},"references":{"cite":{"order":[],"data":{}}}}