*2 - 4*a*c)) / (2*a)\n    print(\"x1 = \", str(x))\n    x = (-b + math.sqrt(b**2 - 4*a*c)) / (2*a)\n    print(\"x2 = \", str(x))\nelif b**2 == 4*a*c:\n    print(\"Funksjonen har ett nullpunkt\")\n    x = (-b + math.sqrt(b**2 - 4*a*c)) / (2*a)\n    print(\"x = \" + str(x))\nelse:\n    print(\"Funksjonen har ingen nullpunkter\")","key":"l3zi2KuGAn"}],"class":"dropdown","key":"xu24i16nY2"}],"key":"NGUKvEThSA"}],"key":"iFKdlIxPGJ"},"references":{"cite":{"order":[],"data":{}}}}