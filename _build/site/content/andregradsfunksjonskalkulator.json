2 == 4*a*c:\n    print(\"Funksjonen har ett nullpunkt\")\n    x = (-b + math.sqrt(b**2 - 4*a*c)) / (2*a)\n    print(\"x = \" + str(x))\nelse:\n    print(\"Funksjonen har ingen nullpunkter\")","key":"lIAioXw5lL"}],"class":"dropdown","key":"rTalySUwMa"}],"key":"EgZRiM0zaR"}],"key":"WuC8ayaAaq"},"references":{"cite":{"order":[],"data":{}}}}