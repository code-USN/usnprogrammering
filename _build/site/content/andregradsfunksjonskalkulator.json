2 == 4*a*c:\n    print(\"Funksjonen har ett nullpunkt\")\n    x = (-b + math.sqrt(b**2 - 4*a*c)) / (2*a)\n    print(\"x = \" + str(x))\nelse:\n    print(\"Funksjonen har ingen nullpunkter\")","key":"zrfqn6KITw"}],"class":"dropdown","key":"owpDzbnIDS"}],"key":"HFO2AnE759"}],"key":"yeBvcK0BQy"},"references":{"cite":{"order":[],"data":{}}}}