96-8b0b-3a76f755d73e","html_id":"db89f0d6-723b-4196-8b0b-3a76f755d73e","key":"EDyEwcIzMX"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Som dere ser over, ble resultatet ganske kantete. “plot()” funksjonen plotter kun inn punktene fra x- og y-tabellen. Datamaskinen kan faktisk egentlig ikke lage kontinuerlige grafer til oss, men hvis vi øker antallet verdier i verditabellen vår så kan vi nærme oss noe som ser kontinuerlig ut:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Q2wMmXaCgy"}],"key":"itfoOPqVf1"}],"identifier":"2eeff111-0070-4616-af29-495d083ade8a","html_id":"2eeff111-0070-4616-af29-495d083ade8a","key":"ijlOVGIGL3"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Oppgave","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vWnKkRjfQr"}],"key":"MbC9UXpx6k"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Fjern tekststrengen “b.” fra plot() funksjonen, så vil du se at programmet tegner en linje mellom punktene i stedet for mange kryss.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ZeeCDw31UM"}],"key":"DnYPs4zbGh"}],"key":"hsZgeOTILb"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Bytt ut verdien til antall elementer c til 20, 50, 100 og se hva som skjer.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"HXzHWVwxwl"}