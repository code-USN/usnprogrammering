{"version":3,"kind":"Notebook","sha256":"b1927164a8d24bc2caaf05c996576962d151394d9c18be3487bedee439294b71","slug":"microbit-automatisk-vanning","location":"/naturfag/microbit-automatisk-vanning.ipynb","dependencies":[],"frontmatter":{"title":"Automatisk potteplantevanning","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"numbering":{"title":{"offset":1}},"thumbnail":"/potteplante-mikrobit-6178c39821baeba4935d2506268b2dd9.jpg","exports":[{"format":"ipynb","filename":"microbit-automatisk-vanning.ipynb","url":"/microbit-automatisk--122b3281fc2a1b0eda70d175e6391d1e.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Av Sigurd Rage - Universitetet i Sørøst-Norge","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hXuXG4hyN0"}],"key":"PzDNpfLLp7"}],"key":"ESgyhMbdUI"},{"type":"block","kind":"notebook-content","data":{"jp-MarkdownHeadingCollapsed":true,"tags":[]},"children":[{"type":"image","url":"/potteplante-mikrobit-6178c39821baeba4935d2506268b2dd9.jpg","alt":"potteplante","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"h0hfuzkSYv","urlSource":"images/potteplante-mikrobit.jpg"}],"visibility":"show","key":"ltlbjgwQVG"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Introduksjon","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jfrl2tju9z"}],"identifier":"introduksjon","label":"Introduksjon","html_id":"introduksjon","implicit":true,"key":"Uh6QGv2sw8"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"I denne aktiviteten skal vi se på hvordan vi kan bruke en microbit til å styre en vannpumpe basert på sensordata fra en jordfuktsensor. Først kommer en beskrivelse av et nesten ferdig system med fuktsensor og pumpe koblet ferdig koblet til microbiten, deretter kommer et forslag til hvordan dette prosjektet kan gjennomføres i klasserommet. Prosjektet krever at man har tilgang på et “breakout board” for microbit, ellers er det utstyret som kreves hyllevare og relativt billig i anskaffelse.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"fbBc3RXhkT"}],"key":"ObhEQxnTmK"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Hele prosjektet, med halvferdig kode kan lastes ned her:","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"gthOKybqA0"}],"key":"Mlkcs5WtHX"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"link","url":"https://www.tinkercad.com/things/0w034yFNd52?sharecode=QMJCpwQsSBU0375orkOx1ITjqXw1VgHsDG9D1CzmHjE","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"https://​www​.tinkercad​.com​/things​/0w034yFNd52​?sharecode​=​QMJCpwQsSBU0375orkOx1ITjqXw1VgHsDG9D1CzmHjE","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"DFVKvRWWbZ"}],"urlSource":"https://www.tinkercad.com/things/0w034yFNd52?sharecode=QMJCpwQsSBU0375orkOx1ITjqXw1VgHsDG9D1CzmHjE","key":"YuQn1oJpvw"}],"key":"ZOS1IOtb0w"}],"key":"yh1HFkhPc4"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Kompetansemål (LK2020)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qvqniEi99A"}],"identifier":"kompetansem-l-lk2020","label":"Kompetansemål (LK2020)","html_id":"kompetansem-l-lk2020",