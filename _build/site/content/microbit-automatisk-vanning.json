,"column":1},"end":{"line":10,"column":1}},"key":"jiDxDqwkEa"}],"key":"FzOJIJMRmw"}],"key":"NG4hPz5IYg"},{"type":"listItem","spread":true,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Slange til vannpumpe","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"DsJkGBFzr2"}],"key":"WlDjiqp1WC"}],"key":"k01LJNJdvE"},{"type":"listItem","spread":true,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Vanntank","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"FXzHADMJx8"}],"key":"o6nnRw327j"}],"key":"B774nUMDoe"},{"type":"listItem","spread":true,"position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Potteplante","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"xvMbiaREaK"}],"key":"DgfVrrI1Sz"}],"key":"kmH5XazDMR"}],"key":"pMVh1xPr2p"}],"key":"N5Nzp2sGaL"},{"type":"block","kind":"notebook-content","data":{"tags":[]},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Koblingsskjema og komponenter","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"acV6rahOwp"}],"identifier":"koblingsskjema-og-komponenter","label":"Koblingsskjema og komponenter","html_id":"koblingsskjema-og-komponenter","implicit":true,"key":"yeUaoVcc0f"}],"visibility":"show","key":"kie75oGTdF"},{"type":"block","kind":"notebook-content","data":{"tags":[]},"children":[{"type":"image","url":"/koblingsskjema-plant-6b5f5d95ca9653fae6bd125d6f1da91f.png","alt":"Koblingsskjema med mikrobit og komponenter","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TqTznRwXlY","urlSource":"images/koblingsskjema-plantevanner.png"}],"visibility":"show","key":"R2bEVjQ8gw"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"I dette skjemaet er jordfuktssensoren koblet til P0 og pumpestyringen koblet til P1. Transistoren virker som en bryter for pumpestyring, og får styringssignalet fra P1. Mellom P1 og transistoren ligger en motstand på 2.2kΩ, da transistoren kun trenger bittelitt strøm for å “slå inn”","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RKSPzOf1dJ"}],"key":"Eb87vxFJfj"}],"key":"lP2IHRkhZ2"},{"type":"block","kind":"notebook-content","data":{"tags":[]},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Jordfuktsensor","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MTbR20Cf4A"}],"identifier":"jordfuktsensor","label":"Jordfuktsensor","html_id":"jordfuktsensor","implicit":true,"key":"U9wRcXqgEo"}],"visibility":"show","key":"n1dBAGIhMk"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"I dette prosjektet brukes en såkalt resistiv jordfuktssensor, som er den enkleste og billigste typen. Denne sensoren har normalt 3 eller 4 koblingspunkter ut fra modulen. VCC kobles til 3V og GND kobles til 0V. AO (analog out) vil gi en spenning inn på P0 avhengig av hvor fuktig jorden i potteplanten er. På noen sensortyper står det SIG istedet for AO på signalpinnen (se kretstegning)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Qw66y9XtJC"}],"key":"IXYbTOYxcn"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Noen slike sensorer har også en DO (digital out), denne skal ikke brukes.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"FynwDgu1Mw"}],"key":"hsvc8ENhil"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Sensoren måler elektrisk motstand i plantejorda. Når jorda blir fuktig vil den lede mer strøm mellom elektrodene enn hvis den er tørr. Typisk vil spenningen fra AO være høyere ved tørr jord og lavere ved fuktig jord. Denne spenningsverdien blir avlest som en digital heltallsverdi av microbit, som vi kan bruke i styringsprogrammet til å ta en avgjørelse om potteplanten trenger vanning. For å en fornuftig terskelverdi for vanning bør man teste denne sensoren i jord.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"wVCq0mO40L"}],"key":"mPx0Kv8DwT"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"En svakhet med denne typer sensorer er at de korroderer i fuktig miljø, som gir de en noe kort levetid. Det finnes også kapasitive jordfuktsensorer, som koster noe mer og har litt mer komplisert tilkobling.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"GxxkdwINPK"}],"key":"YptH7Rx6S6"}],"key":"ingpRztlOK"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Vannpumpe","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YHSqAA8Jex"}],"identifier":"vannpumpe","label":"Vannpumpe","html_id":"vannpumpe","implicit":true,"key":"rfUzgq0qKN"}],"key":"wDcpMP2P6t"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Dette er en vannpumpe som drives av en DC-motor (likestrømsmotor) som krever mellom 3 og 5V. Pumpemotoren trekker en god del strøm, og kan derfor ikke styres direkte fra pinnene til microbiten. Istedet kobles motoren rett på microbitens innebygde strømkilde, pinnene 3V og 0V, men for å kunne styre den, legger vi en transistor imellom. Da vil transistoren fungere som en elektronisk bryter til pumpen.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iQ4jqvjYc2"}],"key":"XMCHwiXV1M"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Microbit sine tilkoblingsporter kan maksimalt levere 10mA strøm, mens 3V – pinnen kan levere 90mA (V1) eller opptil 120mA (V2).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"oBrRBWb497"}],"key":"sUtEkpf2kF"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"En annen ting å ha i bakhodet er at denne pumpen er relativt svak, så vannreservoaret bør være i samme høyde som potteplanten.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"eVXZi2ncZX"}],"key":"hpVq81X02J"}],"key":"UA9viSo5Ay"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Transistor","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qAlUsnwPi3"}],"identifier":"transistor","label":"Transistor","html_id":"transistor","implicit":true,"key":"Amo6n9KJJy"}],"key":"FsU8R21Pde"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Transistoren er en av det 20. århundrets største oppfinnelser og har muliggjort alle de avanserte digitale enhetene vi omgir oss med til daglig. Det er en halvlederkomponent, og har 3 tilkoblinger: Base, Collector og Emitter. I denne kretsen fungerer transistoren rett og slett som en elektronisk bryter, som kan styre om det skal gå strøm igjennom eller ikke. Base kobles i retning mot +3V og Emitter kobles i retning mot 0V (eller GND). Hvorvidt det går strøm gjennom transistoren eller ikke styres av Collector. Det skal svært lite strøm til på Collector for at transistoren leder, derfor kobler vi en relativt stor motstand i serie foran denne terminalen (tilkoblingen). I kretsen under er transistoren satt inn mellom 3V og pumpen. Når det ikke går strøm inn på Base fra P1 vil transistoren sperre for strøm til motoren.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"uRKPlsiwmb"}],"key":"z0FTV3jN6C"}],"key":"ae5J8jbNRV"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Det er forsåvidt akkurat det samme om transistoren er koblet som vist, eller om den er koblet inn mellom motor og GND","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"C7lLO8nWuM"}],"key":"TUNqdkAXYk"}],"key":"pjV62i3Qvt"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Kretsskjema","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WkZ4qwDjAZ"}],"identifier":"kretsskjema","label":"Kretsskjema","html_id":"kretsskjema","implicit":true,"key":"c8xz1jufIc"}],"key":"D8lHJCjzY8"},{"type":"block","kind":"notebook-content","children":[{"type":"image","url":"/potteplantevanner-kr-95c1dc5e038a543ca8a74627effbd4a3.png","alt":"Kretsskjema for prosjektet","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EBF6UTlfX7","urlSource":"images/potteplantevanner-kretsskjema.png"}],"key":"z9fSybcTT4"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Over ser vi et mer standardisert kretsskjema for prosjektet. I sammenligning med koblingsskjemaet lenge opp er det mer abstrakt, men selve sammenkoblingen av komponentene er mer tydelig og oversiktlig.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Ld46How7zq"}],"key":"gmcoPg1rSd"}],"key":"ThmC2umfVB"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Reell oppkobling (kabelspaghetti)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kn2TGJnCL6"}],"identifier":"reell-oppkobling-kabelspaghetti","label":"Reell oppkobling (kabelspaghetti)","html_id":"reell-oppkobling-kabelspaghetti","implicit":true,"key":"bhkXXJGhJG"}],"key":"eZB4VJjV6C"},{"type":"block","kind":"notebook-content","children":[{"type":"image","url":"/kabelspaghetti-b40134a536eeca8d306aded7580f47f4.jpg","alt":"Hvordan det egentlig ser ut","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Ehp852BgK4","urlSource":"images/kabelspaghetti.jpg"}],"key":"AkDNjhHOxK"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Alle skjematiske fremstillinger av kretser ser som regel mye ryddigere ut på papir enn hvordan den faktiske kretsen blir seendes ut på brettet. Hvordan komponentene kobles sammen på koblingsbrettet, og hvordan man får koblet de eksterne delene inn på kretsen krever noe kunnskap om på hvilke måter dette kan gjøres. I litteraturen om teknologi i skolen kalles dette for “handlingskunnskap”.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qwJ75rzKb7"}],"key":"lNdKdHRtFf"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"I dette eksempelet har vi brukt eksperimentkabler, som er ferdig lagde kabler med hann- og hunnterminaler som passer til brettet, samt krokodillekabler for å koble på pumpen.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wiXzRgPyY7"}],"key":"GKeUqVINq8"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Det er også fullt mulig å koble at sammen kun med krokodillekabler, uten koblingsbrett, da blir kabelsalaten tilsvarende mer rotete 🙂","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"DpJfHel2US"}],"key":"LGmurXPk4E"}],"key":"bv1dwP2rIM"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Programmering av styringsenheten","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rkzFgOCaqP"}],"identifier":"programmering-av-styringsenheten","label":"Programmering av styringsenheten","html_id":"programmering-av-styringsenheten","implicit":true,"key":"R4ptl1zKn7"}],"key":"k75chhkm9I"},{"type":"block","kind":"notebook-content","data":{"tags":[]},"children":[{"type":"image","url":"/pumpestyring-makecod-4d13f3fbc8f97267cd8d26a2f46543c2.png","alt":"Eksempelkode for styringsenheten","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hCii37SAso","urlSource":"images/pumpestyring-makecode.png"}],"visibility":"show","key":"waXhCKwX5X"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Programmet over kan være et godt utgangspunkt for styring av pumpen, men den er ikke ferdig. Likevel, et par viktige momenter å ta med seg:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pmXFHEosOd"}],"key":"wFHdGCQ9md"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Sensorverdier fra jordfuktsensoren leses som analogverdi fra P0","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JzhGpLCeXk"}],"key":"NfgJJL3ueA"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Styring av pumpen skjer ved å sette digital verdi på P1 til 1 (3V) for å starte pumpen, og digital verdi P1 til 0 (0V) for å stoppe den.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"dCTae5FDNY"}],"key":"QflNZ47pnF"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"I blokken “ved start” setter vi styringssignalet til pumpen til LOW, eller 0V for å være helt sikre på at pumpen ikke starter av seg selv","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"g8tnevWY00"}],"key":"LnUX5x7mhI"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"For å kunne lese av den digitale verdien fra jordfuktsensoren har vi en kodeblokk “når knapp A trykkes” som skriver denne verdien til skjerm. Dette kan være nyttig for å finne ut hva slags verdier som denne sensoren gir fra tørr eller fuktig jord.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"nkgleJ5zrT"}],"key":"eFS2VozihG"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Selve pumpestyringen skjer i “gjenta for alltid”-sløyfen. I denne eksempelkoden er grensen for at pumpen skal starte satt til verdien 500, men den reelle grenseverdien må finnes ved utprøving på en reell potteplante.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"QWTTt2PXJL"}],"key":"luDr3SVwSo"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Dersom avlest verdi er høyere enn grenseverdien vil if-testen slå inn, og pumpen kjøres i 5 sekunder. Denne verdien må også finnes ved eksperimentering: hvor mye vann pumpes per tid, og hvor mye vann trenger potteplanten per vanning.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"nG5jPMqzSl"}],"key":"csdcw9waB9"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Deretter venter systemet i 1 minutt før den sjekker fuktigheten i potteplanten på nytt. Dette er nok alt for kort tid i en reell situasjon, og systemet trenger kanskje ikke å sjekke for vanning mer enn et par ganger om dagen. Dessuten trenger potteplanten noe tid for at vannet skal fordeles jevnt i jorden.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"MD20Afer9D"}],"key":"GtQ3QtF40t"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Altså:","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"JYIaL6CPZZ"}],"key":"F1V8xICZdo"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":18,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Man må finne en reell grenseverdi for jordfuktsensoren slik at vanning kommer på ønsket tørrhet","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"mFRT4Z54Rc"}],"key":"XwsfcqZIST"}],"key":"GjqT6pkSlW"},{"type":"listItem","spread":true,"position":{"start":{"line":19,"column":1},"end":{"line":19,"colu