{"version":3,"kind":"Notebook","sha256":"8765d8c6da908b544933fd03aa6b6990fa6d65e8006e03981635e7fbc92a1356","slug":"index","location":"/index.ipynb","dependencies":[],"frontmatter":{"title":"Programmering for lærere","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"exports":[{"format":"ipynb","filename":"index.ipynb","url":"/index-c594e2a6a087732b2f400ba8b0d74a94.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"På denne nettsiden vil vi etterhvert legge ut aktiviteter og opplegg som handler om programmering i skolen.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iOkXacT79t"}],"key":"WA8Jd73ttD"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Disse nettsidene er ikke ment som kurs i grunnleggende programmering, men heller som en samling av kortere eller lengre eksempler på hvordan programmering kan brukes til undervisning og utforsking i matematikk og naturfag.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"BptRB2c5pA"}],"key":"lleiGhAvQL"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"De forskjellige aktivitetene har forskjellig didaktisk tilnærming, men ett viktig poeng er å lære seg å kunne lese kode og kunne koble koding til konkrete aktiviteter i de forskjellige fagene, matematikk og naturfag, og hvordan koding kan forsterke faglig forståelse og hvordan koding kan brukes til utforsking.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"HNTKi50ju8"}],"key":"zhi3oRD4L2"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":