ey":"weeWl0rvE8"}],"key":"ypo1WaRHKM"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Deklarasjon av liste uten innhold\ntomListe = []\n\n# liste med floats\nlisteDesimaltall = [3.3, 4.2, -8.0, 1.6]\n#liste med forskjellige datatyper\nlisteMix = [\"Ole\", 101, True, -4.89]\n\nprint(listeDesimaltall)\nprint(listeMix)","key":"EorC2MtSuf"},{"type":"outputs","id":"lEQj_CCNk_Lty60rO3Bcf","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"[3.3, 4.2, -8.0, 1.6]\n['Ole', 101, True, -4.89]\n"},"children":[],"key":"CHso6AmLaP"}],"key":"k2dfZdIXVS"}],"key":"aMcZTe9puU"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Som dere ser av eksemplet kan en liste bestå av ingen, en eller flere elementer. Siden Python ikke er kresent på datatyper så kan en liste bestå av hvilken som helst av disse og til og med forskjellige datatyper i samme liste. Dette er ikke vanlig i andre programmeringsspråk. For å skrive ut ett element fra listen brukes skrivemåten minListe[posisjon]. Legg merke til at referansen til første element starter på 0 og ikke 1.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"J9JYPoaEJo"}],"key":"IpRCZXEI7t"}],"key":"DDZSijjAFU"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Det går også an å skrive ut deler av listen på en enkel måte. Grensene angis slik: minListe[a:b]. Dersom du ikke angir start eller slutt vil Python anta at du vil ha med alt fra begynnelsen eller alt frem til slutten av listen. Se følgende eksempel:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oa66Q5QjFV"}],"key":"zUekVaoZR4"}],"key":"Jd33eZFm1Y"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"minListe = [\"Ole\", \"Thomas\", \"Kari\", \"Ali\", \"Miriam\", \"Martine\", \"Jonas\", \"Vilde\"]\n\nprint(minListe[2:4])\nprint(minListe[:3])\nprint(minListe[4:])","key":"ypZJ97AqO9"},{"type":"outputs","id":"tHlp84GFVpZH2xOa0maTY","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"['Kari', 'Ali']\n['Ole', 'Thomas', 'Kari']\n['Miriam', 'Martine', 'Jonas', 'Vilde']\n"},"children":[],"key":"SiyCrvJsTy"}],"key":"jP3RcXcLXB"}],"key":"ms3vs3guVO"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Det finnes mange funksjoner som hører til datatypen lister, og vi skal ikke gå igjennom alle sammen her. Men som eksempler på nyttige funksjoner skal vi se på hvordan man kan legge til og fjerne elementer, samt sortere lister. Se eksempelet under:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pEojTdzZYo"}],"key":"uNK1O8wB2k"}],"key":"vFuYuwFuoy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"minListe = [\"Ole\", \"Thomas\", \"Kari\", \"Ali\", \"Miriam\", \"Martine\", \"Jonas\", \"Vilde\"]\nprint(minListe)\n\n# Legger til element på slutten av listen\nminListe.append(\"Hermann\")\nprint(minListe)\n\n# Fjerner et objekt fra listen\nminListe.remove(\"Kari\")\nprint(minListe)\n\n# Fjerner element fra listen basert på ideks, og sparer i en variabel (popping)\nnavn = minListe.pop(1)\nprint(navn)\nprint(minListe)\n\n# Sorterer listen alfabetisk\nminListe.sort()\nprint(minListe)","key":"qBkKgnMuVd"},{"type":"outputs","id":"AiC1AXB-5r4S_CfArjtw5","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"['Ole', 'Thomas', 'Kari', 'Ali', 'Miriam', 'Martine', 'Jonas', 'Vilde']\n['Ole', 'Thomas', 'Kari', 'Ali', 'Miriam', 'Martine', 'Jonas', 'Vilde', 'Hermann']\n['Ole', 'Thomas', 'Ali', 'Miriam', 'Martine', 'Jonas', 'Vilde', 'Hermann']\nThomas\n['Ole', 'Ali', 'Miriam', 'Martine', 'Jonas', 'Vilde', 'Hermann']\n['Ali', 'Hermann', 'Jonas', 'Martine', 'Miriam', 'Ole', 'Vilde']\n"},"children":[],"key":"JfyWccxgKy"}],"key":"teUTUQjdAc"}],"key":"enim5PyIiL"},{"type":"block","kind":"notebook-content","children":[{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":1,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Append legger til et element på slutten av listen.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dmhnUIPoE9"}],"key":"j8ibuRgOM3"}],"key":"dYgh5WKse5"},{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Remove trekker fra bestemte objekter i lista. Hvis flere elementer er likeså fjernes alle.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"qzYBRWztZd"}],"key":"rNWb6zQWe6"}],"key":"JqbXbUKwQP"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Pop henter ut et element fra listen og returnerer elementet slik at det kan for eksempel skrives ut eller legges i en annen variabel. Dersom pop kalles uten indeks (for eksempel: minListe.pop() ), vil den hente ut det siste elementet i listen.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Rt8dTutUYN"}],"key":"az4qhHCk9W"}],"key":"VG1vHdRiGi"}],"key":"wpHBoa5A4b"}],"key":"jDQH7OicZJ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Iterasjon av lister","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"L9z9gextsU"}],"identifier":"iterasjon-av-lister","label":"Iterasjon av lister","html_id":"iterasjon-av-lister","implicit":true,"key":"hvB0yVph99"}],"key":"JYSJ9OX6A6"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Å iterere en liste betyr å «bla igjennom lista», gjerne i en for-sløyfe. I mange kodespråk gjøres dette på den første måten som vist i eksempelet over ved at man lager en teller (index) som teller fra 0 og til antall elementer i listen, og henter ut elementene ved hjelp av denne indeksen.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"szSXpKeO0I"}],"key":"V7F3jRUBLo"}],"key":"Ejs6DN2St9"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"En mer snedig måte å gjøre dette på er vist i den nederste metoden: Her skjønner pyton at den skal gå igjennom listen, men i stedet for å bruke en tallindeks, henter python automatisk hvert element in i sløyfevariablen direkte.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OTTBvvD2WP"}],"key":"C9OshJbtdR"}],"key":"jWmdtnwtMz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"minListe = [\"Ole\", \"Thomas\", \"Kari\", \"Ali\", \"Miriam\", \"Martine\", \"Jonas\", \"Vilde\"]\n\n# Iterasjon med index, len() gir lengden på lista\nfor index in range(len(minListe)):\n    print(minListe[index])\n\n# for mellomrom i utskrift\nprint(\"\")\n\n# Iterasjon med elementmetode (snedig)\nfor element in minListe:\n    print(element)\n","key":"nxg17F9emt"},{"type":"outputs","id":"eFD05ACjdJtMLif